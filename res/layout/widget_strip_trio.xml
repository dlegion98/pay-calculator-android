<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@android:id/background" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_bg">
    <ImageView android:id="@+id/glow" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop"/>
    <LinearLayout android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical" android:padding="8dp">
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal">
        <TextView android:id="@+id/v1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="17sp" android:textStyle="bold" android:fontFamily="sans-serif-black" android:textColor="@color/w_text" android:singleLine="true"/>
        <TextView android:id="@+id/l1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="This week" android:textSize="11.5sp" android:textColor="@color/w_text2" android:singleLine="true"/>
    </LinearLayout>
    <FrameLayout android:layout_width="1dp" android:layout_height="28dp" android:background="@color/w_field"/>
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal">
        <TextView android:id="@+id/v2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="17sp" android:textStyle="bold" android:fontFamily="sans-serif-black" android:textColor="@color/w_text" android:singleLine="true"/>
        <TextView android:id="@+id/l2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="This month" android:textSize="11.5sp" android:textColor="@color/w_text2" android:singleLine="true"/>
    </LinearLayout>
    <FrameLayout android:layout_width="1dp" android:layout_height="28dp" android:background="@color/w_field"/>
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal">
        <TextView android:id="@+id/v3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="17sp" android:textStyle="bold" android:fontFamily="sans-serif-black" android:textColor="@color/w_text" android:singleLine="true"/>
        <TextView android:id="@+id/l3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tax year" android:textSize="11.5sp" android:textColor="@color/w_text2" android:singleLine="true"/>
    </LinearLayout>
</LinearLayout>
</FrameLayout>
