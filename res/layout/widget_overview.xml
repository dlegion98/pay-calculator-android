<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@android:id/background" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_bg">
    <ImageView android:id="@+id/glow" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop"/>
    <LinearLayout android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <FrameLayout android:layout_width="28dp" android:layout_height="28dp">
            <ImageView android:id="@+id/h_badge" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/w_round" android:scaleType="fitXY"/>
            <ImageView android:id="@+id/h_icon" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="6dp" android:src="@drawable/ic_home"/>
        </FrameLayout>
        <TextView android:id="@+id/h_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginLeft="8dp" android:text="Pay overview" android:textSize="13sp" android:textStyle="bold" android:textColor="@color/w_text2" android:fontFamily="sans-serif-medium" android:singleLine="true" android:ellipsize="end"/><TextView android:id="@+id/updated" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="@color/w_text2"  android:fontFamily="sans-serif" android:singleLine="true" android:ellipsize="end" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="10dp">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="This month" android:textSize="12sp" android:textColor="@color/w_text2"/>
            <TextView android:id="@+id/net" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="30sp" android:textColor="@color/w_text" android:textStyle="bold" android:fontFamily="sans-serif-black" android:singleLine="true" android:ellipsize="end" />
            <TextView android:id="@+id/sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="@color/w_text2"  android:fontFamily="sans-serif" android:singleLine="true" android:ellipsize="end" />
        </LinearLayout>
        <FrameLayout android:layout_width="64dp" android:layout_height="64dp">
            <ImageView android:id="@+id/ring" android:layout_width="match_parent" android:layout_height="match_parent"/>
            <TextView android:id="@+id/pct" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/w_text" android:fontFamily="sans-serif-black"/>
        </FrameLayout>
    </LinearLayout>
    <ImageView android:id="@+id/spark" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="36dp" android:layout_marginTop="6dp" android:layout_marginBottom="6dp" android:scaleType="fitXY"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginLeft="-4dp" android:layout_marginRight="-4dp">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/w_field" android:padding="12dp" android:layout_margin="4dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="This week" android:textSize="11.5sp" android:textColor="@color/w_text2" android:singleLine="true"/>
            <TextView android:id="@+id/week" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="17sp" android:textColor="@color/w_text" android:textStyle="bold" android:fontFamily="sans-serif-black" android:singleLine="true" android:ellipsize="end" />
            <TextView android:id="@+id/week_sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="@color/w_text2"  android:fontFamily="sans-serif" android:singleLine="true" android:ellipsize="end" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/w_field" android:padding="12dp" android:layout_margin="4dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Next pay" android:textSize="11.5sp" android:textColor="@color/w_text2" android:singleLine="true"/>
            <TextView android:id="@+id/next" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="17sp" android:textColor="@color/w_text" android:textStyle="bold" android:fontFamily="sans-serif-black" android:singleLine="true" android:ellipsize="end" />
            <TextView android:id="@+id/next_sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="@color/w_text2"  android:fontFamily="sans-serif" android:singleLine="true" android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginLeft="-4dp" android:layout_marginRight="-4dp">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/w_field" android:padding="12dp" android:layout_margin="4dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tax year net" android:textSize="11.5sp" android:textColor="@color/w_text2" android:singleLine="true"/>
            <TextView android:id="@+id/ty" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="17sp" android:textColor="@color/w_text" android:textStyle="bold" android:fontFamily="sans-serif-black" android:singleLine="true" android:ellipsize="end" />
            <TextView android:id="@+id/ty_sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="@color/w_text2"  android:fontFamily="sans-serif" android:singleLine="true" android:ellipsize="end" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/w_field" android:padding="12dp" android:layout_margin="4dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Hours this month" android:textSize="11.5sp" android:textColor="@color/w_text2" android:singleLine="true"/>
            <TextView android:id="@+id/hrs" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="17sp" android:textColor="@color/w_text" android:textStyle="bold" android:fontFamily="sans-serif-black" android:singleLine="true" android:ellipsize="end" />
            <TextView android:id="@+id/hrs_sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="@color/w_text2"  android:fontFamily="sans-serif" android:singleLine="true" android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
</FrameLayout>
