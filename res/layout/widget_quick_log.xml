<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@android:id/background" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_bg">
    <ImageView android:id="@+id/glow" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop"/>
    <LinearLayout android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="14dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Log a shift" android:textSize="13sp" android:textStyle="bold" android:textColor="@color/w_text2" android:fontFamily="sans-serif-medium"/>
        <TextView android:id="@+id/sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11.5sp" android:textColor="@color/w_text2"  android:fontFamily="sans-serif" android:singleLine="true" android:ellipsize="end" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="40dp" android:orientation="horizontal" android:layout_marginTop="8dp" android:layout_marginLeft="-4dp" android:layout_marginRight="-4dp">
        <FrameLayout android:id="@+id/b4" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginLeft="4dp" android:layout_marginRight="4dp">
            <ImageView android:id="@+id/b4_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/w_pill" android:scaleType="fitXY"/>
            <TextView android:id="@+id/b4_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="4h" android:textSize="15sp" android:textStyle="bold" android:fontFamily="sans-serif-medium"/>
        </FrameLayout>
        <FrameLayout android:id="@+id/b8" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginLeft="4dp" android:layout_marginRight="4dp">
            <ImageView android:id="@+id/b8_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/w_pill" android:scaleType="fitXY"/>
            <TextView android:id="@+id/b8_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="8h" android:textSize="15sp" android:textStyle="bold" android:fontFamily="sans-serif-medium"/>
        </FrameLayout>
        <FrameLayout android:id="@+id/b12" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginLeft="4dp" android:layout_marginRight="4dp">
            <ImageView android:id="@+id/b12_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/w_pill" android:scaleType="fitXY"/>
            <TextView android:id="@+id/b12_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="12h" android:textSize="15sp" android:textStyle="bold" android:fontFamily="sans-serif-medium"/>
        </FrameLayout>
        <FrameLayout android:id="@+id/badd" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginLeft="4dp" android:layout_marginRight="4dp">
            <ImageView android:id="@+id/badd_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/w_pill" android:scaleType="fitXY"/>
            <TextView android:id="@+id/badd_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="+" android:textSize="15sp" android:textStyle="bold" android:fontFamily="sans-serif-medium"/>
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
</FrameLayout>
